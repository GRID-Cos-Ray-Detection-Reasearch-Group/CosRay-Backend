# Django 本地开发配置
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret-key
ALLOWED_HOSTS=localhost, 127.0.0.1, 10.0.2.2, 10.0.3.2

# Database
# 对应 docker-compose service name 'postgres'
DATABASE_URL=postgres://cosray:cosray@postgres:5432/cosray

# IoTDB
# 对应 docker-compose service name 'iotdb'
IOTDB_HOST=iotdb
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# Redis
# 对应 docker-compose service name 'redis'
REDIS_URL=redis://:cosray-local-redis-password@redis:6379/0

# Security
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
