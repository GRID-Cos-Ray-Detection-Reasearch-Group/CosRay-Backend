#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# 运行数据库迁移
>&2 echo "Running database migrations..."
python manage.py migrate --noinput

# 使用 uvicorn 启动 ASGI 服务（支持自动重载）
>&2 echo "Starting uvicorn development server with auto reload..."
exec uvicorn config.asgi:application --host 0.0.0.0 --port 8000 --reload
