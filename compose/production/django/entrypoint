#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# 等待 PostgreSQL 就绪
if [ -z "${POSTGRES_USER:-}" ]; then
    base_postgres_image_default_user='postgres'
    export POSTGRES_USER="${base_postgres_image_default_user}"
fi

export DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

>&2 echo "Waiting for PostgreSQL at ${POSTGRES_HOST}:${POSTGRES_PORT}..."
wait-for-it "${POSTGRES_HOST}:${POSTGRES_PORT}" -t 30

>&2 echo 'PostgreSQL is available'

# 等待 IoTDB 就绪（如果配置了）
if [ -n "${IOTDB_HOST:-}" ]; then
    >&2 echo "Waiting for IoTDB at ${IOTDB_HOST}:${IOTDB_PORT:-6667}..."
    wait-for-it "${IOTDB_HOST}:${IOTDB_PORT:-6667}" -t 30 || >&2 echo "Warning: IoTDB may not be ready"
    >&2 echo 'IoTDB is available'
fi

exec "$@"
