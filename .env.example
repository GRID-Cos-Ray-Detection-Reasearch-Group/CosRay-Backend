# Django 核心配置
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=unsafe-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 数据库配置 (PostgreSQL)
# ------------------------------------------------------------------------------
# 此项对应 docker-compose.local.yml 中的 `postgres` 服务
DATABASE_URL=postgres://cosray:cosray@localhost:5432/cosray

# IoTDB 配置
# ------------------------------------------------------------------------------
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# CORS 配置
# ------------------------------------------------------------------------------
# 允许跨域请求的 origin 列表（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 认证配置
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
