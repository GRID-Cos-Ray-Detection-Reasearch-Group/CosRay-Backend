# Django 核心配置
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=unsafe-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置 (PostgreSQL)
# ------------------------------------------------------------------------------
# 本地开发使用 Docker 容器，使用默认配置
# 生产环境必须修改密码和主机地址
DATABASE_URL=postgres://cosray:cosray@localhost:5432/cosray

# IoTDB 配置
# ------------------------------------------------------------------------------
# 本地开发使用 Docker 容器，使用默认配置
# 生产环境必须修改密码
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# CORS 配置
# ------------------------------------------------------------------------------
# 允许的跨域来源，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 认证配置
# ------------------------------------------------------------------------------
# Access Token 有效期（小时）
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
# Refresh Token 有效期（天）
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
