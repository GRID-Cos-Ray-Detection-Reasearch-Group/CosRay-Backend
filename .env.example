# Django 核心配置
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置 (PostgreSQL)
# ------------------------------------------------------------------------------
# 此项对应 docker-compose.local.yml 中的 `postgres` 服务
DATABASE_URL=postgres://cosray:cosray@localhost:5432/cosray

# IoTDB 配置
# ------------------------------------------------------------------------------
IOTDB_HOST=localhost
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# 缓存配置
# ------------------------------------------------------------------------------
# 本地未启用 Redis 时可留空，Django 将回退到进程内缓存。
REDIS_URL=

# CORS 配置
# ------------------------------------------------------------------------------
# 是否允许所有域名的跨域请求（仅临时调试建议打开）
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 认证配置
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
